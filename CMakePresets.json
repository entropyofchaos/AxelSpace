{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "inherits": "windows-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-x86-debug",
            "displayName": "Windows x86 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-x86-release",
            "displayName": "Windows x86 Release",
            "inherits": "windows-x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x64 Debug",
            "inherits": "linux-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "inherits": "linux-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-x86-debug",
            "displayName": "Linux x86 Debug",
            "inherits": "linux-base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-x86-release",
            "displayName": "Linux x86 Release",
            "inherits": "linux-x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "configurePreset": "windows-x64-debug",
            "description": "Build using the Windows x64-debug configuration preset",
            "targets": ["all"],
            "configuration": "Debug",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "configurePreset": "windows-x64-release",
            "description": "Build using the Windows x64-release configuration preset",
            "targets": ["all"],
            "configuration": "Release",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "windows-x86-debug",
            "displayName": "Windows x86 Debug",
            "configurePreset": "windows-x86-debug",
            "description": "Build using the Windows x86-debug configuration preset",
            "targets": ["all"],
            "configuration": "Debug",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "windows-x86-release",
            "displayName": "Windows x86 Release",
            "configurePreset": "windows-x86-release",
            "description": "Build using the Windows x86-release configuration preset",
            "targets": ["all"],
            "configuration": "Release",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x64 Debug",
            "configurePreset": "linux-x64-debug",
            "description": "Build using the Linux x64-debug configuration preset",
            "targets": ["all"],
            "configuration": "Debug",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "configurePreset": "linux-x64-release",
            "description": "Build using the Linux x64-release configuration preset",
            "targets": ["all"],
            "configuration": "Release",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "linux-x86-debug",
            "displayName": "Linux x86 Debug",
            "configurePreset": "linux-x86-debug",
            "description": "Build using the Linux x86-debug configuration preset",
            "targets": ["all"],
            "configuration": "Debug",
            "cleanFirst": true,
            "verbose": true
        },
        {
            "name": "linux-x86-release",
            "displayName": "Linux x86 Release",
            "configurePreset": "linux-x86-release",
            "description": "Build using the Linux x86-release configuration preset",
            "targets": ["all"],
            "configuration": "Release",
            "cleanFirst": true,
            "verbose": true
        }
    ],
    "testPresets": [
        {
            "name": "windows-x64-release-test",
            "description": "Windows x64 Release Test Configuration",
            "configurePreset": "windows-x64-release",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "linux-x64-release-test",
            "description": "Linux x64 Release Test Configuration",
            "configurePreset": "linux-x64-release",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}